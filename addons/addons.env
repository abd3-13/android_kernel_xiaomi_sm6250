# Pinned upstream add-on sources.
#
# Bump a SHA only after checking that the patched kernel still builds and
# the expected symbols below are present in out/.config. Environment variables
# of the same name take precedence, which is useful for testing an update.
#
# USB Arsenal: kernel-patches/<VERSION>.<PATCHLEVEL>/
: "${USB_ARSENAL_REPO:=https://github.com/ravindu644/USB-Arsenal}"
: "${USB_ARSENAL_REF:=5ced5ed1e8eb99a79d5470c7bfd1e37822878439}"

# Droidspaces: Documentation/resources/kernel-patches/non-GKI/
: "${DROIDSPACES_REPO:=https://github.com/ravindu644/Droidspaces-OSS}"
: "${DROIDSPACES_REF:=c4cd876ba33a916b63bfef3dd0ccedb93cd13035}"

# AnyKernel3 packaging template (branch r5x at the time of writing)
: "${ANYKERNEL_REPO:=https://github.com/Amritorock/AnyKernel3}"
: "${ANYKERNEL_REF:=560fd55ddf072309e316315684ba57eaef795632}"
